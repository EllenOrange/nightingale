---
const flagship = [
  {
    title: "Flexible cache folders",
    description:
      "Keep cache, videos, models, and vendor tools in separate folders from the main data directory. Existing files migrate with safety checks so larger libraries are easier to organize.",
  },
  {
    title: "Auto-analysis",
    description:
      "Let scans automatically queue newly discovered unanalyzed songs, so large libraries move from import to playable karaoke with less babysitting.",
  },
  {
    title: "Touch-friendly playback",
    description:
      "Phones and tablets now get on-screen playback controls, clearer hints, and a more adaptive menu/playback layout for smaller screens.",
  },
];

const alsoNew = [
  {
    title: "Settings page migration",
    description:
      "Settings moved from a modal into a dedicated page for easier browsing.",
  },
  {
    title: "Lyrics placement",
    description:
      "Move lyrics top, center, or bottom and align them left, center, or right.",
  },
  {
    title: "Mic latency test",
    description:
      "A beep-based calibration writes latency compensation for tighter scoring.",
  },
];
---

<section id="highlights">
  <div class="container">
    <div class="header">
      <h2>What&apos;s new in v0.8</h2>
      <a href="/docs/" class="docs-link">See full docs</a>
    </div>

    <div class="flagship-row">
      {
        flagship.map((item) => (
          <article class="highlight-card flagship">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>

    <div class="dense-row">
      {
        alsoNew.map((item) => (
          <article class="highlight-card dense">
            <h4>{item.title}</h4>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .docs-link {
    font-size: 0.9rem;
    color: var(--accent);
  }

  .flagship-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 14px;
  }

  .dense-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .highlight-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .highlight-card.flagship {
    padding: 22px;
  }

  .highlight-card.dense {
    padding: 14px;
  }

  .highlight-card h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .highlight-card h4 {
    margin: 0 0 6px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .highlight-card.flagship p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .highlight-card.dense p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .flagship-row {
      grid-template-columns: 1fr;
    }

    .dense-row {
      grid-template-columns: 1fr;
    }
  }
</style>
