---
const highlights = [
  {
    title: "CJK lyric support",
    description:
      "Japanese, Chinese, and Korean lyrics get per-character forced alignment with romanized readings (Hepburn, pinyin, Revised Romanization) shown above each token.",
  },
  {
    title: "Parakeet v3 ASR (experimental)",
    description:
      "Alternative to Whisper for ~25 European languages. NeMo on CUDA, ONNX Runtime on CPU and Apple Silicon. Pick it from Settings.",
  },
  {
    title: "UltraStar Deluxe songs (experimental)",
    description:
      "Drop USDX song folders into your library and play them with their built-in pitch and lyric data. No analyzer pass needed.",
  },
  {
    title: "Audio-reactive shaders",
    description:
      "Ten GPU backgrounds (five new) react to your microphone in real time \u2014 louder vocals push the visuals harder.",
  },
  {
    title: "Built-in updater",
    description:
      "On macOS and Windows, Nightingale checks for new releases on launch, badges the sidebar avatar when one is ready, and installs signed updates with one click. Linux ships without the updater — the Update entry opens GitHub Releases for a manual download.",
  },
];
---

<section id="highlights">
  <div class="container">
    <div class="header">
      <h2>What&apos;s new in v0.6</h2>
      <a href="/docs/" class="docs-link">See full docs</a>
    </div>
    <div class="highlights-grid">
      {
        highlights.map((item) => (
          <article class="highlight-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }

  .docs-link {
    font-size: 0.9rem;
    color: var(--accent);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .highlight-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.04);
    padding: 18px;
  }

  .highlight-card h3 {
    margin: 0 0 6px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .highlight-card p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .highlights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
