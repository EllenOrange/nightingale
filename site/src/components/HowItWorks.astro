---
const steps = [
  {
    title: "Source",
    description:
      "Point Nightingale at your music: a local folder, or a Jellyfin or Navidrome server. Run it as the desktop app or the self-hosted web build \u2014 either way, the pipeline is the same.",
  },
  {
    title: "Separate",
    description:
      "UVR Karaoke or Demucs splits the track into vocals and instrumental. Audio is extracted from video files automatically; songs from a server are cached locally on first play.",
  },
  {
    title: "Transcribe",
    description:
      "Synced lyrics are looked up on LRCLIB first. If nothing's found, WhisperX (or Parakeet v3, experimental) transcribes the vocals with word-level alignment. CJK songs get romanized readings above each token.",
  },
  {
    title: "Play",
    description:
      "Playback includes highlighted lyrics, pitch scoring, key/tempo controls, mic monitoring, and dynamic backgrounds.",
  },
];
---

<section id="how-it-works">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">The pipeline</span>
        <h2 class="section-title">From track to stage in four steps</h2>
      </div>
      <a href="/docs/how-it-works.html" class="docs-link">
        Read pipeline docs
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <div class="steps">
      {
        steps.map((step, i) => (
          <div class="step">
            <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .step {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 26px 22px;
    border: 1px solid var(--border);
    transition: transform 0.25s ease, border-color 0.25s ease,
      background 0.25s ease;
  }

  .step:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 14px;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .step h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .step p {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
